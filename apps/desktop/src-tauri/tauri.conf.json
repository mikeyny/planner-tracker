{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Deep",
	"version": "0.1.0",
	"identifier": "com.techvest.deep",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:5180",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Deep",
				"width": 1320,
				"height": 860,
				"minWidth": 980,
				"minHeight": 640,
				"center": true,
				"dragDropEnabled": false,
				"visible": false,
				"backgroundColor": "#0f0e12"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		]
	}
}
