{
	"manifest_version": 3,
	"name": "Deep Focus Guard",
	"version": "0.1.0",
	"description": "Blocks distracting sites while a Deep focus session runs, and tells Deep which site you're on.",
	"key": "",
	"minimum_chrome_version": "120",
	"background": { "service_worker": "background.js", "type": "module" },
	"permissions": ["declarativeNetRequest", "storage", "tabs", "alarms"],
	"host_permissions": ["<all_urls>"],
	"action": { "default_popup": "popup.html", "default_title": "Deep" },
	"icons": { "32": "icons/32.png", "128": "icons/128.png" },
	"web_accessible_resources": [
		{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }
	]
}
